{
  "name": "tinynpm",
  "displayName": "tinyNpm",
  "description": "Security focused npm package.json companion",
  "version": "0.2.6",
  "publisher": "about14sheep",
  "license": "MIT",
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/about14sheep/tinyNpm.git"
  },
  "bugs": {
    "url": "https://github.com/about14sheep/tinyNpm/issues"
  },
  "homepage": "https://github.com/about14sheep/tinyNpm#readme",
  "keywords": [
    "npm",
    "package.json",
    "security",
    "dependencies",
    "supply chain"
  ],
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "tinynpm user configuration",
      "properties": {
        "tinynpm.versionBufferPeriod": {
          "type": "number",
          "default": 3,
          "description": "Minimum age in days for package versions (helps avoid newly published malicious packages)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "pretty": "prettier --write src/**/*.ts",
    "test": "vscode-test",
    "vsix:package": "vsce package",
    "vsix:publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/semver": "^7.7.1",
    "@types/vscode": "1.107.0",
    "@vscode/test-cli": "0.0.11",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "semver": "7.8.5"
  }
}
